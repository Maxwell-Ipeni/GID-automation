# Get It Done - Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=True
APP_NAME="Get It Done"

# Amazon Affiliate
AMAZON_AFFILIATE_TAG=your-amazon-affiliate-tag-20
AMAZON_BASE_URL=https://www.amazon.com

# Pinterest API
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=your-pinterest-api-access-token
PINTEREST_BOARD_ID=your-pinterest-board-id
PINTEREST_API_BASE=https://api.pinterest.com/v5

# Scraping Configuration
SCRAPE_DELAY_MIN=5
SCRAPE_DELAY_MAX=10
SCRAPE_INTERVAL_HOURS=12

# Publishing Configuration
PUBLISH_INTERVAL_MINUTES=360
PUBLISH_DELAY_MIN_MINUTES=60
PUBLISH_DELAY_MAX_MINUTES=180
PUBLISH_RETRY_ATTEMPTS=1
PUBLISH_RETRY_DELAY_SECONDS=5

# Buffer (fallback publisher)
BUFFER_API_KEY=
BUFFER_PINTEREST_CHANNEL_ID=
BUFFER_TWITTER_CHANNEL_ID=
TWITTER_MAX_CHARS=280

# Pin Image Settings
PIN_WIDTH=1000
PIN_HEIGHT=1500
PIN_IMAGE_DIR=generated_images

# NVIDIA AI (content generation)
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# Convex DB
CONVEX_URL=https://your-project.convex.cloud

# Security
API_KEY=your-super-secret-api-key
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
